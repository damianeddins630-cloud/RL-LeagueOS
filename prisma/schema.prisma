generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model League {
  id         String      @id @default(cuid())
  name       String
  season     String
  totalWeeks Int         @default(10)
  franchises Franchise[]
  matches    Match[]
  createdAt  DateTime    @default(now())
}

model Franchise {
  id           String     @id @default(cuid())
  name         String
  abbreviation String
  conference   String
  leagueId     String
  league       League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  members      Member[]
  homeMatches  Match[]    @relation("HomeTeam")
  awayMatches  Match[]    @relation("AwayTeam")

  @@index([leagueId])
}

model Member {
  id          String           @id @default(cuid())
  name        String
  gamertag    String
  tier        Int              @default(1)
  franchiseId String
  franchise   Franchise        @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  gameStats   PlayerGameStat[]

  @@index([franchiseId])
}

model Match {
  id              String      @id @default(cuid())
  week            Int
  scheduledAt     DateTime
  leagueId        String
  league          League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeFranchiseId String
  awayFranchiseId String
  homeFranchise   Franchise   @relation("HomeTeam", fields: [homeFranchiseId], references: [id])
  awayFranchise   Franchise   @relation("AwayTeam", fields: [awayFranchiseId], references: [id])
  status          String      @default("SCHEDULED")
  series          Series[]

  @@index([leagueId, week])
}

model Series {
  id          String           @id @default(cuid())
  gameNumber  Int
  matchId     String
  match       Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeGoals   Int              @default(0)
  awayGoals   Int              @default(0)
  replayFile  String?
  playerStats PlayerGameStat[]

  @@index([matchId])
}

model PlayerGameStat {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  goals    Int    @default(0)
  saves    Int    @default(0)
  assists  Int    @default(0)
  shots    Int    @default(0)
  demos    Int    @default(0)

  @@index([seriesId])
  @@index([memberId])
}

// --- Auth & player accounts ---

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  rlTrackerUrl  String?
  accounts      Account[]
  sessions      Session[]
  application   LeagueApplication?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeagueApplication {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  discordName String
  age         Int
  whyJoining  String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
